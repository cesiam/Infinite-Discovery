# --- API (backend/app) ---
# Fingerprint drafts: "auto" uses Claude when credentials are available
# (ANTHROPIC_API_KEY or an `ant auth login` profile), else templates.
# FINGERPRINT_DRAFTER=auto
# ANTHROPIC_API_KEY=
# FINGERPRINT_DRAFT_MODEL=claude-opus-5-5
# AUTH_MODE=dev                      # anything else disables /auth/dev/login
# CORS_ORIGINS=http://localhost:3000
# SIMILAR_POST_MAX_DISTANCE=0.70
